# ==========================================================
#  学习计划定制系统 —— 配置模板
#  使用方法：复制本文件为 .env，然后填入你自己的 API Key
# ==========================================================

# DeepSeek 开放平台申请的 API Key（必填）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的APIKey

# 接口地址（OpenAI 兼容格式），官方文档：https://api-docs.deepseek.com/zh-cn/
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型 ID。界面上显示的 DeepSeek-V4.1-Flash，在 API 中的模型名就是 deepseek-flash
# （旧名 deepseek-v4-flash 仍可调用，同样由 DeepSeek-V4.1-Flash 提供服务）
DEEPSEEK_MODEL=deepseek-flash

# 单次请求超时时间（秒）。思考模式 + 长计划建议给足
DEEPSEEK_TIMEOUT=300

# 单次生成的最大输出 token 数
DEEPSEEK_MAX_TOKENS=8192

# 本地服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 允许跨域的来源，多个用英文逗号分隔；* 表示不限制（本地开发方便）
ALLOW_ORIGINS=*
